<!DOCTYPE html>
<html lang="{{t.htmlLang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{pageTitle}}</title>

  {{{metaTags}}}
  {{{structuredData}}}

  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preload" href="/css/main.css?v=1237" as="style">
  <link rel="stylesheet" href="/css/main.css?v=1237">
  <link rel="stylesheet" href="/css/variety.css?v=3">
  <script async data-id="101511163" src="//static.getclicky.com/js"></script>
</head>
<body>
  <main class="variety-page">
    <header class="home-hero" style="display:flex;align-items:center;gap:1rem;margin:2.5rem 0 0.5rem;">
      <a href="{{homeHref}}"><img src="/images/me.jpeg" alt="{{t.person.name}}" style="width:56px;height:56px;border-radius:50%;object-fit:cover;"></a>
      <div>
        <a href="{{homeHref}}" style="font-weight:600;text-decoration:none;">{{t.person.name}}</a>
        <div style="font-size:0.85rem;color:var(--color-secondary-text,#666);">{{t.person.tagline}}</div>
      </div>
      {{> lang-switch}}
    </header>

    <!-- 1. Hero -->
    <header class="variety-hero">
      <div class="variety-hero-text">
        <h1 class="variety-title">{{t.variety.heroTitle}}</h1>
        <p class="variety-subtitle">{{t.variety.heroSubtitle}}</p>
        <p class="variety-byline">{{t.variety.heroByline}}</p>
      </div>
      <a class="variety-cover" href="{{t.variety.coverHref}}">
        <img src="{{t.variety.coverImage}}" width="560" height="800" alt="{{t.variety.coverAlt}}" loading="eager" decoding="async">
      </a>
    </header>

    <!-- 2. About -->
    <section class="variety-about variety-prose">
      {{{t.variety.about}}}
    </section>

    <div class="section-divider"></div>

    <!-- 3. Read the chapters -->
    <section class="variety-sample">
      <p class="variety-bridge">{{t.variety.bridge}}</p>

      <p class="variety-read-links">
        <a class="variety-read-link" href="{{t.variety.readPrimary.href}}" lang="{{t.variety.readPrimary.lang}}">{{t.variety.readPrimary.text}}</a><br>
        <a class="variety-read-link" href="{{t.variety.readSecondary.href}}" lang="{{t.variety.readSecondary.lang}}">{{t.variety.readSecondary.text}}</a>
      </p>
    </section>

    <div class="section-divider"></div>

    <!-- 4. Subscribe -->
    <section class="variety-subscribe">
      <h2>{{t.variety.subscribeHeading}}</h2>
      <p>{{t.variety.subscribeText}}</p>
      <div class="variety-substack">
        <iframe src="https://kiosan.substack.com/embed" width="480" height="320" style="border: 1px solid #EEE; background: white" frameborder="0" scrolling="no" title="{{t.variety.subscribeIframeTitle}}"></iframe>
      </div>
    </section>
  </main>


  <script type="module" src="/js/app.js"></script>
</body>
</html>
