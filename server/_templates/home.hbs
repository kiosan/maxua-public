<!DOCTYPE html>
<html lang="{{t.htmlLang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{pageTitle}}</title>

  {{{metaTags}}}
  {{{structuredData}}}

  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preload" href="/css/main.css?v=1237" as="style">
  <link rel="stylesheet" href="/css/main.css?v=1237">
  <style>
    .home-page { max-width: 640px; margin: 0 auto; padding: 0 1rem; }
    .home-hero { display: flex; align-items: center; gap: 1.25rem; margin: 3rem 0 2.5rem; }
    .home-hero img { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; }
    .home-hero h1 { margin: 0 0 0.25rem; font-size: 1.8rem; letter-spacing: -0.01em; }
    .home-hero p { margin: 0; color: var(--color-secondary-text, #666); }
    .home-block { margin: 0 0 2.25rem; font-size: 1.1rem; line-height: 1.7; }
    .home-block h2 { font-size: 1.25rem; margin: 0 0 0.5rem; }
    .home-block p { margin: 0 0 0.75rem; }
    .home-link { font-weight: 600; text-decoration: none; }
    .home-link:hover { text-decoration: underline; }
    .home-social { margin: 2.5rem 0 3rem; }
    .home-book { display: flex; align-items: flex-start; gap: 1.5rem; }
    .home-cover { flex: 0 0 auto; line-height: 0; }
    .home-cover img { width: 120px; height: auto; border-radius: 3px; box-shadow: 0 1px 2px rgba(0,0,0,0.12), 0 10px 24px -12px rgba(0,0,0,0.35); }
    .home-book-text { flex: 1 1 auto; min-width: 0; }
    @media (max-width: 480px) { .home-book { gap: 1rem; } .home-cover img { width: 92px; } }
    .home-hero .lang-switch { margin-left: auto; align-self: flex-start; }
    .lang-switch { font-size: 0.8rem; letter-spacing: 0.04em; color: var(--color-secondary-text, #666); white-space: nowrap; }
    .lang-switch a { color: inherit; text-decoration: none; padding: 0.15rem 0.2rem; }
    .lang-switch a:hover { text-decoration: underline; }
    .lang-switch a.active { color: var(--color-text, #222); font-weight: 600; }
    .lang-switch-sep { margin: 0 0.15rem; }
  </style>
  <script async data-id="101511163" src="//static.getclicky.com/js"></script>
</head>
<body>
  <main class="home-page">
    <header class="home-hero">
      <img src="/images/me.jpeg" alt="{{t.person.name}}">
      <div>
        <h1>{{t.person.name}}</h1>
        <p>{{t.person.tagline}}.</p>
      </div>
      {{> lang-switch}}
    </header>

    <section class="home-block home-book">
      <a class="home-cover" href="{{varietyHref}}"><img src="{{#if isUk}}/images/variety-cover-uk-sm.png{{else}}/images/variety-cover-en-sm.png{{/if}}" width="280" height="400" alt="{{t.home.bookCoverAlt}}" loading="lazy" decoding="async"></a>
      <div class="home-book-text">
      <h2>{{t.home.bookHeading}}</h2>
      <p>{{{t.home.bookText}}}</p>
      <p><a class="home-link" href="{{varietyHref}}">{{t.home.bookLink}}</a></p>
      </div>
    </section>

    <section class="home-block">
      <h2>{{t.home.reintechHeading}}</h2>
      <p>{{{t.home.reintechText}}}</p>
      <p><a class="home-link" href="https://reintech.io">{{t.home.reintechLink}}</a></p>
    </section>

    <section class="home-social">
      <a class="home-link" href="https://www.linkedin.com/in/obondar/">{{t.home.linkedin}}</a>
    </section>
  </main>

</body>
</html>
